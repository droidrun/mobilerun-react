{
  "name": "@mobilerun/react",
  "version": "0.1.0",
  "description": "React components for embedding Mobilerun's native device streaming (WebRTC + scrcpy) — plug-and-play with @mobilerun/sdk.",
  "license": "Apache-2.0",
  "author": "Mobilerun <support@droidrun.ai>",
  "homepage": "https://github.com/droidrun/mobilerun-react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/droidrun/mobilerun-react.git"
  },
  "bugs": {
    "url": "https://github.com/droidrun/mobilerun-react/issues"
  },
  "keywords": [
    "mobilerun",
    "react",
    "android",
    "device-streaming",
    "webrtc",
    "scrcpy",
    "remote-control",
    "cloud-device",
    "components"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "bun run build:js && bun run build:css",
    "build:js": "tsup",
    "build:css": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify",
    "dev": "tsup --watch",
    "example": "bun run build:css && bun --hot ./example/server.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.553.0",
    "tailwind-merge": "^3.2.0"
  },
  "peerDependencies": {
    "@mobilerun/sdk": ">=2.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@mobilerun/sdk": "^2.1.0",
    "@tailwindcss/cli": "^4.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "hono": "^4.12.27",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4.1.5",
    "tsup": "^8.5.1",
    "tw-animate-css": "^1.2.5",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
