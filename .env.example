# Example dev harness config. Copy to .env and fill in.
# Bun auto-loads .env — these are read ONLY by example/server.ts (server-side).
# The secret key never reaches the browser; the SDK helper uses it server-side.
# Stream WebSockets are direct browser connections authenticated with ?token=.

# Required: your mobilerun secret API key (dr_sk_…).
MOBILERUN_API_KEY=dr_sk_your_key_here

# Optional: upstream API host WITHOUT the /v1 suffix. Defaults to the SDK's production URL.
#   dev      → https://dev-api.mobilerun.ai
#   staging  → https://staging-api.mobilerun.ai
#   prod     → https://api.mobilerun.ai
# MOBILERUN_API_URL=https://api.mobilerun.ai

# Optional: port for the dev harness. Default: 3000.
# PORT=3000
