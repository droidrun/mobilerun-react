{
  "max_attempts": 6,
  "connect_timeout_ms": 45000,
  "stability_ms": 30000,
  "backoff": {
    "base_delay_ms": 1000,
    "max_delay_ms": 30000,
    "formula": "round(min(base_delay_ms * 2^(max(1, attempt) - 1), max_delay_ms) * (0.75 + random * 0.5)); random in [0, 1), random = 1 only as the upper-bound limit case",
    "rounding": "round half toward +infinity (Math.round)"
  },
